# update from git if things have changed on the remote.
# if there are local changes, they will be stashed and then popped after the update.

# only check for updates every 6 hours, so new shells don't all pay for a git fetch.
UPDATE_STAMP="$DOTFILES_DIR/.last-update-check"
if [ -n "$(find "$UPDATE_STAMP" -mmin -360 2>/dev/null)" ]; then
  return
fi

# if we don't have internet, exit early.
internet_up || return

touch "$UPDATE_STAMP"

CURRENT_BRANCH=$(git -C "$DOTFILES_DIR" rev-parse --abbrev-ref HEAD)

# fetch updates from remote
git -C "$DOTFILES_DIR" fetch origin $CURRENT_BRANCH &>/dev/null

# check if we're behind the remote
if [ "$(git -C "$DOTFILES_DIR" rev-list HEAD..origin/$CURRENT_BRANCH --count 2>/dev/null || echo 0)" -gt 0 ]; then
  # check if we have local changes (including staged and untracked)
  if [ -n "$(git -C "$DOTFILES_DIR" status --porcelain)" ]; then
    # stash local changes, untracked included. if we can't stash (e.g. repo left
    # in a conflicted state), don't attempt the update at all.
    if git -C "$DOTFILES_DIR" stash -u; then
      LOCAL_CHANGES=1
    else
      echo "WARNING: couldn't stash local dotfiles changes; skipping update. Check 'git status' in $DOTFILES_DIR."
      return
    fi
  fi

  # pull changes; only flag the update as done if the pull actually worked
  if git -C "$DOTFILES_DIR" pull origin $CURRENT_BRANCH; then
    UPDATED_DOTFILES=true
  else
    echo "WARNING: dotfiles pull failed; skipping update."
  fi

  # restore local changes if we stashed them
  if [ "$LOCAL_CHANGES" = "1" ]; then
    if ! git -C "$DOTFILES_DIR" stash pop; then
      # a conflicted pop leaves merge markers in the working tree; throw that mess
      # away and keep the clean upstream files. the local changes are safe in the stash.
      git -C "$DOTFILES_DIR" reset --hard HEAD &>/dev/null
      echo "WARNING: your local dotfiles changes conflict with the update. Kept the upstream files; your changes are preserved in 'git stash' — resolve manually in $DOTFILES_DIR."
    fi
  fi
fi
