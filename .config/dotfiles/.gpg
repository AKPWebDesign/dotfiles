function gpg_cache () {
  KEYGRIP=B878F61F173C53B25D6ECFD80658F9FF9C3125F9
  # skip the 1password round-trip if the agent already has the passphrase cached
  if gpg-connect-agent "KEYINFO $KEYGRIP" /bye 2>/dev/null | grep -q " 1 P"; then
    return
  fi
  export GPG_TTY=$(tty)
  gpg-connect-agent reloadagent /bye &> /dev/null
  if [ -z "$OP_SERVICE_ACCOUNT_TOKEN" ]; then
    eval $(op signin)
  fi
  op read op://secrets/gpg/password | "$(gpgconf --list-dirs libexecdir)"/gpg-preset-passphrase --preset $KEYGRIP
}
gpg_cache
